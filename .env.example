# URL del nodo Webhook de n8n (usa /webhook-test/ mientras pruebas en el editor, /webhook/ en producción)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/picking-detection

# Modelo YOLO (se descarga automáticamente la primera vez)
YOLO_MODEL=yolo11n.pt

# Índice de la cámara web
CAMERA_INDEX=0

# Clases objetivo separadas por comas (nombres COCO)
TARGET_CLASSES=cell phone,cup

# Umbral de confianza para disparar el webhook (estrictamente mayor que)
CONFIDENCE_THRESHOLD=0.70

# Segundos de espera entre notificaciones de la misma clase
COOLDOWN_SECONDS=5
